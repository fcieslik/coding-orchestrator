{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "ticketId": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "completed"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        }
      },
      "required": [
        "schemaVersion",
        "ticketId",
        "summary",
        "status",
        "commit"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "ticketId": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "blocked"
        },
        "blocker": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "string",
              "minLength": 1
            },
            "requiredDecision": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "schemaVersion",
        "ticketId",
        "summary",
        "status",
        "blocker"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "ticketId": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "failed"
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string"
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "schemaVersion",
        "ticketId",
        "summary",
        "status",
        "diagnostics"
      ],
      "additionalProperties": {}
    }
  ]
}
