{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "ticketId": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "completed"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "skipped"
                ]
              },
              "exitCode": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "command",
              "status"
            ],
            "additionalProperties": {}
          }
        },
        "review": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "clean"
                },
                "findings": {
                  "maxItems": 0,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "axis": {
                        "type": "string",
                        "enum": [
                          "standards",
                          "spec"
                        ]
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "reference": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "requiredDecision": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "axis",
                      "summary",
                      "requiredDecision"
                    ],
                    "additionalProperties": {}
                  }
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": {}
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "attention"
                },
                "findings": {
                  "minItems": 1,
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "axis": {
                        "type": "string",
                        "enum": [
                          "standards",
                          "spec"
                        ]
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "reference": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "requiredDecision": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "axis",
                      "summary",
                      "requiredDecision"
                    ],
                    "additionalProperties": {}
                  }
                }
              },
              "required": [
                "status",
                "findings"
              ],
              "additionalProperties": {}
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "ticketId",
        "summary",
        "status",
        "commit",
        "commands"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "ticketId": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "blocked"
        },
        "blocker": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "string",
              "minLength": 1
            },
            "requiredDecision": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "schemaVersion",
        "ticketId",
        "summary",
        "status",
        "blocker"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "ticketId": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "failed"
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string"
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "schemaVersion",
        "ticketId",
        "summary",
        "status",
        "diagnostics"
      ],
      "additionalProperties": {}
    }
  ]
}
