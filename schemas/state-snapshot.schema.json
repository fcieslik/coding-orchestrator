{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "string",
              "pattern": "^run_(\\d{4})(?:(0[13578]|1[02])(0[1-9]|[12]\\d|3[01])|(0[469]|11)(0[1-9]|[12]\\d|30)|(02)(0[1-9]|1\\d|2[0-9]))T([01]\\d|2[0-3])([0-5]\\d)([0-5]\\d)Z_[0-9a-f]{12}$"
            },
            {
              "not": {
                "pattern": "^run_\\d{4}0229T"
              }
            }
          ]
        },
        {
          "type": "string",
          "pattern": "^run_(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)0229T(?:[01]\\d|2[0-3])[0-5]\\d[0-5]\\dZ_[0-9a-f]{12}$"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "phase": {
      "type": "string",
      "enum": [
        "created",
        "preparing",
        "implementing",
        "reviewing",
        "checking",
        "fixing",
        "blocked",
        "failed",
        "cancelled",
        "completed"
      ]
    },
    "specification": {
      "type": "string",
      "minLength": 1
    },
    "interruptedPhase": {
      "type": "string",
      "enum": [
        "created",
        "preparing",
        "implementing",
        "reviewing",
        "checking",
        "fixing",
        "blocked",
        "failed",
        "cancelled",
        "completed"
      ]
    },
    "fixReturnPhase": {
      "type": "string",
      "enum": [
        "reviewing",
        "checking"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "git": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "runBase": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "featureBranch": {
          "type": "string",
          "minLength": 1
        },
        "featureWorktree": {
          "type": "string",
          "minLength": 1
        },
        "worktreeStatus": {
          "type": "string",
          "enum": [
            "planned",
            "ready",
            "removed"
          ]
        },
        "validatedHead": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        }
      },
      "required": [
        "schemaVersion",
        "runBase",
        "featureBranch",
        "featureWorktree",
        "worktreeStatus"
      ],
      "additionalProperties": {}
    },
    "workflowPackage": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "specification": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "snapshot",
        "specification"
      ],
      "additionalProperties": {}
    },
    "tickets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "accepted"
            ]
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          }
        },
        "required": [
          "status",
          "input"
        ],
        "additionalProperties": {}
      }
    },
    "activeExecution": {
      "type": "object",
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "ticketId": {
          "type": "string",
          "minLength": 1
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "executionId",
        "ticketId",
        "attemptId",
        "path"
      ],
      "additionalProperties": {}
    },
    "lastExecution": {
      "type": "object",
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "ticketId": {
          "type": "string",
          "minLength": 1
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "executionId",
        "ticketId",
        "attemptId",
        "path"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "revision",
    "phase",
    "specification",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": {}
}
