{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^run_(\\d{4})(?:(0[13578]|1[02])(0[1-9]|[12]\\d|3[01])|(0[469]|11)(0[1-9]|[12]\\d|30)|(02)(0[1-9]|1\\d|2[0-9]))T([01]\\d|2[0-3])([0-5]\\d)([0-5]\\d)Z_[0-9a-f]{12}$"
    },
    "ticketId": {
      "type": "string",
      "minLength": 1
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "prepared",
        "running",
        "reconciling",
        "accepted",
        "blocked",
        "failed"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "worker",
        "fixer"
      ]
    },
    "agentProfile": {
      "type": "string",
      "minLength": 1
    },
    "agentKind": {
      "type": "string",
      "const": "codex"
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "ticket": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "source",
        "input",
        "hash"
      ],
      "additionalProperties": {}
    },
    "specification": {
      "type": "string",
      "minLength": 1
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "brief": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "directory",
        "input",
        "record",
        "output"
      ],
      "additionalProperties": {}
    },
    "promptHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "promptDelivery": {
      "type": "string",
      "enum": [
        "not-started",
        "unknown",
        "confirmed"
      ]
    },
    "retry": {
      "type": "object",
      "properties": {
        "previousAttemptId": {
          "type": "string",
          "minLength": 1
        },
        "previousExecutionId": {
          "type": "string",
          "minLength": 1
        },
        "previousInputHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "refreshed": {
          "type": "boolean"
        }
      },
      "required": [
        "previousAttemptId",
        "previousInputHash",
        "inputHash",
        "refreshed"
      ],
      "additionalProperties": {}
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "previousValidatedHead": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "acceptedCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        }
      },
      "required": [
        "previousValidatedHead",
        "acceptedCommit"
      ],
      "additionalProperties": {}
    },
    "timestamps": {
      "type": "object",
      "properties": {
        "preparedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "settledAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "finalizedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        }
      },
      "required": [
        "preparedAt"
      ],
      "additionalProperties": {}
    },
    "herdr": {
      "type": "object",
      "properties": {
        "callerPaneId": {
          "type": "string",
          "minLength": 1
        },
        "paneId": {
          "type": "string",
          "minLength": 1
        },
        "agentName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "callerPaneId",
        "agentName"
      ],
      "additionalProperties": {}
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-attempted",
            "closed",
            "failed"
          ]
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": {}
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "type": "string",
          "minLength": 1
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": {}
    },
    "ownership": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "token",
        "fingerprint"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "executionId",
    "runId",
    "ticketId",
    "attemptId",
    "attempt",
    "status",
    "role",
    "agentProfile",
    "agentKind",
    "skill",
    "ticket",
    "worktree",
    "artifacts",
    "promptHash",
    "timestamps"
  ],
  "additionalProperties": {}
}
