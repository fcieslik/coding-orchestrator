{
  "name": "coding-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm schema:generate && tsup src/cli.ts --format esm --clean",
    "format": "prettier --write package.json pnpm-workspace.yaml tsconfig.json eslint.config.js scripts/generate-schemas.ts src tests",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.json eslint.config.js scripts/generate-schemas.ts src tests",
    "lint": "eslint .",
    "schema:check": "node --experimental-strip-types scripts/generate-schemas.ts --check",
    "schema:generate": "node --experimental-strip-types scripts/generate-schemas.ts",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "4.0.17"
  }
}
